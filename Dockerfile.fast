# Thin production image for VPS fast-deploy.
# Expects a staging context that already contains Next standalone output:
#   server.js, node_modules/, .next/static/, public/
# Built by scripts/studio-fast-deploy.sh — no npm ci / next build here.

FROM node:22-alpine
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apk add --no-cache curl \
  && addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --chown=nextjs:nodejs . ./

USER nextjs
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=8 \
  CMD curl -sf "http://127.0.0.1:3000/api/health" >/dev/null || exit 1

CMD ["node", "server.js"]
