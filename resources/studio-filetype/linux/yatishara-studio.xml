<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.yatishara.studio">
    <comment>Yatishara Studio project</comment>
    <comment xml:lang="en">Yatishara Studio project</comment>
    <acronym>STUDIO</acronym>
    <expanded-acronym>Yatishara Studio project package</expanded-acronym>
    <glob weight="80" pattern="*.studio"/>
    <!-- YSTUDIO magic (envelope); weight beats weak octet-stream -->
    <magic priority="90">
      <match type="string" offset="0" value="YSTUDIO"/>
    </magic>
    <alias type="application/x-yatishara-studio"/>
    <icon name="application-vnd.yatishara.studio"/>
    <generic-icon name="package-x-generic"/>
  </mime-type>
</mime-info>
